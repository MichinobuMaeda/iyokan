rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSystemAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.valid == true;
    }
    function isUser(orgId) {
      return request.auth != null && exists(/databases/$(database)/documents/org/$(orgId)/users/$(request.auth.uid)) && request.auth.uid in get(/databases/$(database)/documents/org/$(orgId)/users/$(request.auth.uid)).data.valid == true;
    }
    function isManager(orgId) {
      return isUser(orgId) && get(/databases/$(database)/documents/org/$(orgId)/groups/managers).data.members == true;
    }
    function isAdmins(orgId) {
      return isUser(orgId) && get(/databases/$(database)/documents/org/$(orgId)/groups/admins).data.members == true;
    }
    match /service/conf {
      allow read: if true;
      allow read, write: if isSystemAdmin();
    }
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow read, write: if isSystemAdmin();
    }
    match /providers/{providerId} {
      allow read: if request.auth != null;
      allow read, write: if isSystemAdmin();
    }
    match /org/{orgId} {
      allow read: if isUser(orgId);
      allow read, write: if isSystemAdmin() || isManager(orgId) || isAdmin(orgId);
    }
    match /org/{orgId}/providers/{providerId} {
      allow read, write: if isSystemAdmin() || isAdmin(orgId);
    }
    match /org/{orgId}/users/{userId} {
      allow read: if isUser(orgId);
      allow read, write: if isSystemAdmin() || isManager(orgId);
    }
    match /org/{orgId}/groups/{groutId} {
      allow read: if isUser(orgId);
      allow read, write: if isSystemAdmin() || isManager(orgId);
    }
    match /org/{orgId}/groups/manager {
      allow read, write: if isSystemAdmin() || isManager(orgId);
    }
    match /org/{orgId}/groups/admins {
      allow read, write: if isSystemAdmin() || isManager(orgId);
    }
    match /org/{orgId}/groups/manager {
      allow read, write: if isSystemAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
