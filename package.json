{
  "name": "iyokan",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000",
    "build:functions": "npm run build --prefix functions",
    "build:ui": "tsc -b && vite build",
    "build": "npm run build:functions && npm run build:ui",
    "test:data": "npx firebase firestore:delete service/version -f",
    "start": "npm run build:functions && npx firebase emulators:exec --only auth,functions,firestore,storage,tasks --ui --import test/emulator 'npm run test:data && npm run dev'",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:app": "vitest run --coverage",
    "test": "npm test --prefix functions && npm run test:app"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.7.0",
    "fp-ts": "^2.16.11",
    "glassine-paper": "^1.2.5",
    "i18next": "^25.7.4",
    "jose": "^6.1.3",
    "jotai": "^2.16.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.12.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.1.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.0.0"
  }
}
